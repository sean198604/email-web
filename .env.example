# ===== 邮件群发工具 · 网页版 (email-web) 环境变量示例 =====
# 复制本文件为 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，不会进入仓库 / 镜像。请勿把真实密钥写进 docker-compose.yml。

# JWT 签名密钥（必填，务必替换为强随机值）
# 生成命令：openssl rand -base64 48
JWT_SECRET=""

# 管理员引导：首次用该邮箱 + 下方密码注册，自动成为管理员(role=admin)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# HTTP 本地部署设为 false；HTTPS 公网部署设为 true 或删除该项（默认按 production 启用）
COOKIE_SECURE="false"

# 邮件追踪（可选但建议配置）：收件人能够访问的应用公网根地址，不要以 / 结尾。
# 本地调试可用 http://localhost:5051；公网部署示例为 https://email.pocketbay.app
APP_URL="http://localhost:5051"

# AI 介绍信（可选，OpenAI 兼容协议）
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-chat"

# 名片宝客户导入（可选；Docker 容器访问宿主机服务时使用默认地址）
CARD_RESEARCH_BASE_URL="http://host.docker.internal:7004"
